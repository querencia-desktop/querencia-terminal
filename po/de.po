msgstr "Reiter nach _rechts verschieben"

#. TRANSLATORS: Menüleiste.
#: src/menus.rs:147
msgid "_Help"
msgstr "_Hilfe"

#. TRANSLATORS: Menü „Hilfe“, öffnet die Hilfeseiten auf querencialinux.org im Browser.
#: src/menus.rs:152
msgid "_Online Help"
msgstr "_Online-Hilfe"

#. TRANSLATORS: Menü „Hilfe“, öffnet die Kürzelübersicht.
#: src/menus.rs:154
