msgstr "_Fehler melden"

#. TRANSLATORS: Menü „Hilfe“.
#: src/menus.rs:163
msgid "_About"
msgstr "_Info"

#. TRANSLATORS: steht hinter „Error:“, daher klein und ohne Punkt.
#: src/shell.rs:70
msgid "no executable shell found"
msgstr "keine ausführbare Shell gefunden"

#. TRANSLATORS: {shell} ist der Pfad der Shell, {error} die Meldung von GLib; steht hinter „Error:“.
#: src/shell.rs:106
#, no-c-format
msgid "{shell} could not be started: {error}"
msgstr "{shell} konnte nicht gestartet werden: {error}"

#. TRANSLATORS: rot vor der Meldung im Terminal, z. B. „Error: no executable shell found“.
#: src/shell.rs:134
msgid "Error:"
msgstr "Fehler:"

